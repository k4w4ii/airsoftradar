{
  "_doc": "source: 'sitemap' | 'listing'. sitemap: URL vagy 'auto' (robots.txt). product_pattern: termék URL regex. max_products: napi felső korlát (alap 2000). headers: extra HTTP fejlécek. enabled=false -> kihagyva.",
  "gunfire": {
    "source": "listing",
    "start_urls": [
      "https://gunfire.com/en/menu/electric-powered-rifles-and-carbines-17201.html"
    ],
    "product_pattern": "/en/products/",
    "page_tpl": "{url}?counter={n0}",
    "status": "✓ kategóriaoldal JSON-LD (60/oldal, EUR), lapozás ?counter= működik"
  },
  "taiwangun": {
    "source": "listing",
    "start_urls": [
      "https://www.taiwangun.com/assault-rifle-aeg"
    ],
    "product_pattern": "^https://www\\.taiwangun\\.com/assault-rifle-aeg/[a-z0-9-]+$",
    "page_tpl": "{url}/page:{n}",
    "status": "termékoldal ✓ (USD) | kategória: 61 terméklink ✓ | lapozás '/page:N' feltételezés -> dry-run-nal ellenőrizni"
  },
  "evike-europe": {
